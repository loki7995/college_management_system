DJANGO_DB_NAME=student_management_system
DJANGO_DB_USER=django_auth_user
DJANGO_DB_PASSWORD=your_mysql_password_here
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3307

# Local development defaults to DEBUG=True and a temporary per-process secret.
# For production, set a stable secret and set DJANGO_DEBUG=False.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=

# Email defaults to Django's console backend for local development.
# Configure SMTP credentials through environment variables for real delivery.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=no-reply@your-college-domain.example

# Enable only after configuring HTTPS on your deployment.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
